{
  "name": "pokeforge-lab",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch:data": "node scripts/fetch-data.mjs",
    "fetch:teams": "node scripts/fetch-teams.mjs",
    "fetch:knowledge": "node scripts/fetch-knowledge.mjs",
    "build:zh-hans": "node scripts/build-zh-hans-dictionary.mjs",
    "fetch:teams:fast": "set ENRICH_TEAMS=0&& node scripts/fetch-teams.mjs",
    "fetch:missing-all": "node scripts/fetch-data.mjs && node scripts/fetch-teams.mjs && node scripts/fetch-knowledge.mjs",
    "fetch:all": "node scripts/fetch-data.mjs && node scripts/fetch-teams.mjs && node scripts/fetch-knowledge.mjs",
    "qa:strict-build": "node scripts/qa-strict-team-build.mjs",
    "qa:strict-ui": "node scripts/qa-strict-ui.mjs",
    "qa:hard-constraints-ui": "node scripts/qa-hard-constraints-ui.mjs",
    "qa:build-variation": "node scripts/qa-build-variation-ui.mjs",
    "qa:showdown-bridge": "node scripts/qa-showdown-bridge.mjs",
    "qa:speedline": "node scripts/qa-speedline.mjs",
    "qa:battle-eval": "node scripts/qa-battle-eval.mjs",
    "qa:agent-stack": "node scripts/qa-agent-stack.mjs",
    "qa:showdown-account": "node scripts/qa-showdown-account.mjs",
    "qa:rules-registry": "node scripts/qa-rules-registry.mjs",
    "qa:candidate-library": "node scripts/qa-candidate-library.mjs",
    "qa:zh-hans-ui": "node scripts/qa-zh-hans-ui.mjs",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "capture:social": "node scripts/capture-social-screenshots.mjs",
    "postinstall": "npm --prefix node_modules/pokemon-showdown run build",
    "start": "npx http-server -p 4173 -c-1 .",
    "start:ai": "node server.mjs",
    "dev:forge": "vite --host 127.0.0.1 --port 5173",
    "build:forge": "vite build",
    "preview:forge": "vite preview --host 127.0.0.1 --port 4173"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.60.0",
    "vite": "^7.0.6"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.468.0",
    "pokemon-showdown": "github:smogon/pokemon-showdown#master",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
